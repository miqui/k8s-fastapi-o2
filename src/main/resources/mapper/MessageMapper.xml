<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.messageservice.mapper.MessageMapper">

    <resultMap id="messageResultMap" type="com.example.messageservice.model.Message">
        <constructor>
            <idArg column="id" javaType="string"/>
            <arg column="title" javaType="string"/>
            <arg column="content" javaType="string"/>
            <arg column="sender" javaType="string"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="version" javaType="_int"/>
        </constructor>
    </resultMap>

    <!-- id is a secondary sort key so paging stays stable across requests even when two rows
         share the same created_at (millisecond ties can otherwise reorder a row across pages). -->
    <select id="findAll" resultMap="messageResultMap">
        SELECT id, title, content, sender, created_at, version
        FROM messages
        ORDER BY created_at, id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="findById" resultMap="messageResultMap">
        SELECT id, title, content, sender, created_at, version
        FROM messages
        WHERE id = #{id}
    </select>

    <insert id="insert">
        INSERT INTO messages (id, title, content, sender, created_at)
        VALUES (#{id}, #{title}, #{content}, #{sender}, #{createdAt})
    </insert>

    <!-- Optimistic locking: only applies the write if version still matches what the caller
         read. 0 affected rows means someone else updated the row in between - MessageService
         treats that as a conflict instead of silently overwriting their change (lost update). -->
    <update id="update">
        UPDATE messages
        SET title = #{title}, content = #{content}, version = version + 1
        WHERE id = #{id} AND version = #{version}
    </update>

    <delete id="deleteById">
        DELETE FROM messages
        WHERE id = #{id}
    </delete>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM messages
    </select>

</mapper>
